{
  "name": "stonemind",
  "version": 1,
  "color": {
    "themes": [
      { "id": "washi", "name": "Washi & Shu", "scheme": "light", "default": true, "usage": "Default light theme: washi paper, kaya board, sumi ink, a vermilion seal-red accent." },
      { "id": "hinoki", "name": "Hinoki & Indigo", "scheme": "light", "usage": "Alternative light theme: hinoki cypress board, indigo (ai-iro) ink." },
      { "id": "night", "name": "Night", "scheme": "dark", "provisional": true, "usage": "Dark theme for prefers-color-scheme: dark. Provisional: not yet reviewed with the owner." }
    ],
    "tokens": [
      { "name": "bg", "value": { "washi": "#F6F1E7", "hinoki": "#F8F4EA", "night": "#0F1115" }, "usage": "Page ground." },
      { "name": "surface", "value": { "washi": "#FFFFFF", "hinoki": "#FFFFFF", "night": "#1A1E25" }, "usage": "Opaque cards and panels." },
      { "name": "border", "value": { "washi": "#E3DACA", "hinoki": "#D9CFBB", "night": "#2A303A" }, "usage": "Hairlines only." },
      { "name": "text", "value": { "washi": "#1A1A1A", "hinoki": "#1E2A4A", "night": "#ECE9E2" }, "usage": "Body and headings. At least 12:1 on bg and surface." },
      { "name": "text-2", "value": { "washi": "#4A443D", "hinoki": "#434A5C", "night": "#C5C9D1" }, "usage": "Secondary text. At least 7:1 on bg and surface, and AA on glass." },
      { "name": "text-3", "value": { "washi": "#625B52", "hinoki": "#5A6275", "night": "#A3ABB8" }, "usage": "Tertiary text and captions. At least 4.5:1 on bg and surface. Not on glass." },
      { "name": "primary", "value": { "washi": "#A8432A", "hinoki": "#2C4A7A", "night": "#E8835F" }, "usage": "The one main action per view (fill)." },
      { "name": "on-primary", "value": { "washi": "#FFFFFF", "hinoki": "#FFFFFF", "night": "#0F1115" }, "usage": "Text on primary. At least 4.5:1." },
      { "name": "link", "value": { "washi": "#7F2E1B", "hinoki": "#2C4A7A", "night": "#EDA58C" }, "usage": "Links. AA on bg, surface and glass." },
      { "name": "accent", "value": { "washi": "#A8432A", "hinoki": "#2C4A7A", "night": "#E8835F" }, "usage": "Last-move marker, suggested-move ring, highlights. Fill or stroke only." },
      { "name": "focus", "value": { "washi": "#7F2E1B", "hinoki": "#2C4A7A", "night": "#EDA58C" }, "usage": "2px focus ring, 2px offset. At least 3:1 on bg." },
      { "name": "success", "value": { "washi": "#3E6B4F", "hinoki": "#2F6B4F", "night": "#7BC59A" }, "usage": "Strengths and success. Always with an icon and a word." },
      { "name": "warning", "value": { "washi": "#8A5A1F", "hinoki": "#7A5416", "night": "#E0B464" }, "usage": "Warnings. Always with an icon and a word." },
      { "name": "danger", "value": { "washi": "#9B1C4A", "hinoki": "#9B1C4A", "night": "#F07AA3" }, "usage": "Errors. Crimson, so it is never confused with the shu accent. Always with an icon and a word." },
      { "name": "table", "value": { "washi": "#B9874A", "hinoki": "#A4865A", "night": "#14171C" }, "usage": "The surface the board sits on: the app backdrop behind glass." },
      { "name": "board", "value": { "washi": "#D9A95B", "hinoki": "#DDBE84", "night": "#3A3024" }, "usage": "Go board wood (kaya, hinoki)." },
      { "name": "board-edge", "value": { "washi": "#A87A38", "hinoki": "#A88A55", "night": "#241D16" }, "usage": "The board's lower edge." },
      { "name": "board-line", "value": { "washi": "#6E4A1A", "hinoki": "#6F5733", "night": "#9C8664" }, "usage": "Grid lines and star points." },
      { "name": "stone-black", "value": { "washi": "#1A1A1A", "hinoki": "#1B2440", "night": "#0B0C0E" }, "usage": "Black stones. The Lit Stone mark's body." },
      { "name": "stone-white", "value": { "washi": "#FFFFFF", "hinoki": "#FFFFFF", "night": "#ECE9E2" }, "usage": "White stones." },
      { "name": "glass-tint", "value": { "washi": "rgba(246, 241, 231, 0.78)", "hinoki": "rgba(248, 244, 234, 0.78)", "night": "rgba(26, 30, 37, 0.80)" }, "usage": "Glass panel fill. Opaque enough that text, text-2 and link stay AA over every backdrop, black and white stones included." },
      { "name": "glass-clear", "value": { "washi": "rgba(255, 255, 255, 0.38)", "hinoki": "rgba(255, 255, 255, 0.40)", "night": "rgba(255, 255, 255, 0.06)" }, "usage": "Secondary buttons and chips on glass." },
      { "name": "glass-active", "value": { "washi": "rgba(255, 255, 255, 0.85)", "hinoki": "rgba(255, 255, 255, 0.88)", "night": "rgba(255, 255, 255, 0.14)" }, "usage": "The selected segment of a segmented control." },
      { "name": "glass-well", "value": { "washi": "rgba(120, 90, 50, 0.10)", "hinoki": "rgba(44, 74, 122, 0.08)", "night": "rgba(0, 0, 0, 0.25)" }, "usage": "Inset wells inside glass." },
      { "name": "glass-edge", "value": { "washi": "rgba(255, 255, 255, 0.60)", "hinoki": "rgba(255, 255, 255, 0.65)", "night": "rgba(255, 255, 255, 0.12)" }, "usage": "1px glass border." },
      { "name": "glass-rim", "value": { "washi": "rgba(255, 255, 255, 0.85)", "hinoki": "rgba(255, 255, 255, 0.90)", "night": "rgba(255, 255, 255, 0.18)" }, "usage": "Inner top highlight." },
      { "name": "glass-sheen", "value": { "washi": "rgba(255, 255, 255, 0.50)", "hinoki": "rgba(255, 255, 255, 0.50)", "night": "rgba(255, 255, 255, 0.06)" }, "usage": "Top sheen gradient start." },
      { "name": "glass-shadow", "value": { "washi": "rgba(70, 45, 15, 0.20)", "hinoki": "rgba(30, 42, 74, 0.24)", "night": "rgba(0, 0, 0, 0.50)" }, "usage": "Wide drop shadow, tinted with the theme, never grey." },
      { "name": "primary-glass", "value": { "washi": "rgba(168, 67, 42, 0.90)", "hinoki": "rgba(44, 74, 122, 0.90)", "night": "rgba(232, 131, 95, 0.92)" }, "usage": "Primary button fill on glass." }
    ]
  },
  "contrast": {
    "usage": "Readability rules checked by test/tokens.test.mjs for every theme. Glass pairs are checked with glass-tint composited over each listed backdrop.",
    "pairs": [
      { "fg": "text", "bg": ["bg", "surface"], "min": 12 },
      { "fg": "text-2", "bg": ["bg", "surface"], "min": 7 },
      { "fg": "text-3", "bg": ["bg", "surface"], "min": 4.5 },
      { "fg": "link", "bg": ["bg", "surface"], "min": 4.5 },
      { "fg": "on-primary", "bg": ["primary"], "min": 4.5 },
      { "fg": "focus", "bg": ["bg"], "min": 3 },
      { "fg": "success", "bg": ["bg", "surface"], "min": 4.5 },
      { "fg": "warning", "bg": ["bg", "surface"], "min": 4.5 },
      { "fg": "danger", "bg": ["bg", "surface"], "min": 4.5 }
    ],
    "glass": {
      "tint": "glass-tint",
      "backdrops": ["table", "board", "stone-black", "stone-white"],
      "pairs": [
        { "fg": "text", "min": 7 },
        { "fg": "text-2", "min": 4.5 },
        { "fg": "link", "min": 4.5 }
      ]
    }
  },
  "glass": {
    "blur": "22px",
    "saturate": "170%",
    "usage": "Backdrop filter for glass panels. Panels float over the table and board; never put glass over glass."
  },
  "type": {
    "families": {
      "sans": "\"Inter\", system-ui, sans-serif",
      "brand": "\"Manrope\", \"Inter\", system-ui, sans-serif"
    },
    "groups": [
      {
        "name": "Headings",
        "family": "brand",
        "styles": [
          { "name": "display", "fontSize": "72px", "lineHeight": 1.02, "fontWeight": 800, "letterSpacing": "-0.03em", "usage": "Hero lines only." },
          { "name": "h1", "fontSize": "40px", "lineHeight": 1.1, "fontWeight": 800, "letterSpacing": "-0.02em", "usage": "Page titles." },
          { "name": "h2", "fontSize": "26px", "lineHeight": 1.2, "fontWeight": 700, "letterSpacing": "-0.01em", "usage": "Section titles." },
          { "name": "h3", "fontSize": "20px", "lineHeight": 1.3, "fontWeight": 700, "usage": "Card and panel titles." }
        ]
      },
      {
        "name": "Text",
        "family": "sans",
        "styles": [
          { "name": "body", "fontSize": "16px", "lineHeight": 1.55, "fontWeight": 400, "usage": "Body copy, coach notes. At most 70 characters a line." },
          { "name": "small", "fontSize": "14px", "lineHeight": 1.5, "fontWeight": 400, "usage": "Secondary copy and captions." },
          { "name": "label", "fontSize": "13px", "lineHeight": 1.3, "fontWeight": 700, "letterSpacing": "0.04em", "usage": "Uppercase eyebrows and section labels." }
        ]
      }
    ]
  },
  "spacing": {
    "tokens": [
      { "name": "space-1", "value": "4px", "usage": "Icon-to-text gap." },
      { "name": "space-2", "value": "8px", "usage": "Gaps between related controls." },
      { "name": "space-3", "value": "12px", "usage": "Chip and small button padding." },
      { "name": "space-4", "value": "16px", "usage": "Default gap." },
      { "name": "space-5", "value": "20px", "usage": "Panel padding, gaps between panels." },
      { "name": "space-6", "value": "24px", "usage": "Section gaps." },
      { "name": "space-8", "value": "32px", "usage": "Page sections." }
    ]
  },
  "radius": {
    "tokens": [
      { "name": "radius-sm", "value": "10px", "usage": "Board corners, inputs." },
      { "name": "radius-md", "value": "14px", "usage": "Buttons, icon buttons, segmented controls." },
      { "name": "radius-lg", "value": "22px", "usage": "Glass bars." },
      { "name": "radius-xl", "value": "26px", "usage": "Glass panels." },
      { "name": "radius-pill", "value": "999px", "usage": "Chips." }
    ]
  }
}
