{
  "name": "@stonemind/provider-sdk",
  "version": "0.0.1",
  "description": "Provider and plugin contracts plus the consent-enforcing provider registry.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "stonemind-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
