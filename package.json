{
  "name": "stonemind-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "StoneMind: an adaptive, player-centric, local-first Go companion. Unlock your Go.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/domain",
    "packages/storage",
    "packages/ontology",
    "packages/provider-sdk"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  }
}
